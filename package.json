{
  "publisher": "sankeyangshu",
  "name": "ext-name",
  "displayName": "ext-name",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "Starter Template for VS Code Extension",
  "author": {
    "name": "sankeyangshu",
    "email": "sankeyangshu@gmail.com",
    "url": "https://github.com/sankeyangshu"
  },
  "license": "MIT",
  "homepage": "https://github.com/sankeyangshu/ext-name#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sankeyangshu/ext-name"
  },
  "bugs": {
    "url": "https://github.com/sankeyangshu/ext-name/issues"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "res/icon.png",
  "files": [
    "dist",
    "res/*"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --external vscode",
    "dev": "pnpm run build --watch",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "vscode:prepublish": "pnpm run build",
    "ext:package": "vsce package --no-dependencies",
    "ext:publish": "vsxpub --no-dependencies",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.0",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/node": "^25.0.9",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^10.4.1",
    "eslint": "^10.0.2",
    "lint-staged": "^16.3.2",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vscode-ext-gen": "^1.6.0",
    "vsxpub": "^0.1.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
